# ==========================================
# PDF Document Summarization & Insight Agent
# Environment Configuration Template
# ==========================================

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & Vector Store Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=pdf_knowledge_base

# Chunking & Retrieval Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.2

# Extracted Data Storage Directory
EXTRACTED_DATA_DIR=./data/extracted

# Catalog Storage Directory
CATALOG_DIR=./data/catalog

# Dataset Configuration (defaults to ./data/pdfs)
PDF_DATASET_DIR=./data/pdfs

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
